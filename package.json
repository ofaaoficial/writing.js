{
  "name": "writing.js",
  "version": "2.0.0",
  "description": "Modern, performant, and feature-rich text animation library",
  "main": "dist/writing.js",
  "module": "dist/writing.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:performance": "vitest run tests/performance",
    "bench": "vitest bench",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write src/**/*.{ts,js}",
    "docs": "typedoc src --out docs/api",
    "playground": "vite serve playground",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "analyze": "npm run build -- --analyze"
  },
  "keywords": [
    "typing",
    "animation",
    "text",
    "typewriter",
    "javascript",
    "typescript",
    "ui",
    "frontend"
  ],
  "author": "Writing.js Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/writingjs/writing.js.git"
  },
  "bugs": {
    "url": "https://github.com/writingjs/writing.js/issues"
  },
  "homepage": "https://writing.js.org",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^12.10.0",
    "prettier": "^3.1.0",
    "size-limit": "^10.0.0",
    "@size-limit/preset-small-lib": "^10.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": ">=3.0.0",
    "@angular/core": ">=12.0.0",
    "svelte": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/writing.min.js",
      "limit": "15 KB",
      "gzip": true
    },
    {
      "path": "dist/writing.esm.js",
      "limit": "12 KB",
      "gzip": true
    }
  ],
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}

