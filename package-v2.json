{
  "name": "writing.js",
  "version": "2.0.0",
  "description": "⌨ Enhanced Typography Animation Library - Create beautiful typewriter, fade, and glitch text animations with advanced features, performance optimizations, and framework integrations.",
  "main": "dist/writing.js",
  "module": "dist/writing.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "examples-v2",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "vite serve examples-v2",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src examples-v2",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "release": "npm run build && npm run test && npm publish",
    "playground": "vite serve playground --port 3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofaaoficial/writing.js.git"
  },
  "keywords": [
    "writing",
    "animation",
    "typing",
    "typewriter",
    "fade",
    "glitch",
    "text-animation",
    "typography",
    "javascript",
    "typescript",
    "requestAnimationFrame",
    "performance",
    "react",
    "vue",
    "framework-agnostic",
    "modern",
    "es6",
    "esm",
    "cjs",
    "browser",
    "node"
  ],
  "author": {
    "name": "Oscar Amado",
    "email": "oscarfamado@gmail.com",
    "url": "https://github.com/ofaaoficial"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ofaaoficial/writing.js/issues"
  },
  "homepage": "https://writing-js.dev",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ofaaoficial"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vitest/coverage-v8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "happy-dom": "^12.10.0",
    "prettier": "^3.0.3",
    "rollup": "^3.29.0",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vitepress": "^1.0.0-rc.20",
    "vitest": "^0.34.6"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "import": "./dist/writing.esm.js",
      "require": "./dist/writing.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.esm.js",
      "require": "./dist/react.js",
      "types": "./dist/integrations/useWriting.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.esm.js",
      "require": "./dist/vue.js",
      "types": "./dist/integrations/vueDirective.d.ts"
    },
    "./effects": {
      "import": "./dist/effects.esm.js",
      "require": "./dist/effects.js",
      "types": "./dist/effects/index.d.ts"
    },
    "./playground": {
      "import": "./dist/playground.esm.js",
      "require": "./dist/playground.js",
      "types": "./dist/tools/WritingPlayground.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "unpkg": "dist/writing.min.js",
  "jsdelivr": "dist/writing.min.js",
  "typesVersions": {
    "*": {
      "react": ["dist/integrations/useWriting.d.ts"],
      "vue": ["dist/integrations/vueDirective.d.ts"],
      "effects": ["dist/effects/index.d.ts"],
      "playground": ["dist/tools/WritingPlayground.d.ts"]
    }
  }
}